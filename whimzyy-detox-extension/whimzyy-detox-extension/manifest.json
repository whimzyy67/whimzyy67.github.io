{
  "manifest_version": 3,
  "name": "Whimzyy Detox",
  "version": "2.1.0",
  "description": "Hides Instagram Reels and YouTube Shorts, tracks screen time and enforces the limits you set on the Whimzyy Detox page.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "blocker-instagram.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "blocker-youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.netlify.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open Whimzyy Detox"
  },
  "options_page": "panel.html",
  "externally_connectable": {
    "matches": [
      "https://*.netlify.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}